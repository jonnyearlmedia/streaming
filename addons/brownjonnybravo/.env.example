# The add-on is intentionally local-only by default.
HOST=127.0.0.1
PORT=7000

# Public YouTube metadata refresh interval. Defaults to 900 seconds.
BJB_CACHE_TTL_SECONDS=900

# Optional override if yt-dlp is installed somewhere else.
YTDLP_PATH=yt-dlp

# Set to 1 only for offline development or deterministic tests.
BJB_DISABLE_REFRESH=0
